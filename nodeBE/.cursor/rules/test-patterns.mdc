# Test Patterns

## Overview

This document provides common test patterns and templates for the JoorApp V2 Backend. Use these patterns to ensure consistency across all tests.

## ES Module Mocking Pattern

### Service Test Pattern

```javascript
import { jest, describe, it, expect, beforeAll, beforeEach } from '@jest/globals';

// Mock dependencies
jest.unstable_mockModule('../repositories/userRepository.js', () => ({
  userRepository: {
    findByIdOrFail: jest.fn(),
    create: jest.fn(),
    update: jest.fn()
  }
}));

describe('UserService', () => {
  let userService;
  let userRepository;
  
  beforeAll(async () => {
    const module = await import('../userService.js');
    userService = module;
    const repoModule = await import('../repositories/userRepository.js');
    userRepository = repoModule.userRepository;
  });
  
  beforeEach(() => {
    jest.clearAllMocks();
  });
  
  describe('getUserById', () => {
    it('should return user DTO', async () => {
      // Arrange
      const mockUser = { id: '123', email: 'test@example.com' };
      userRepository.findByIdOrFail.mockResolvedValue(mockUser);
      
      // Act
      const result = await userService.getUserById('123');
      
      // Assert
      expect(result).toEqual({ id: '123', email: 'test@example.com' });
      expect(userRepository.findByIdOrFail).toHaveBeenCalledWith('123');
    });
  });
});
```

## Controller Test Pattern

```javascript
import { jest, describe, it, expect, beforeAll, beforeEach } from '@jest/globals';

// Mock services and validators
jest.unstable_mockModule('../../services/userService.js', () => ({
  getUserById: jest.fn()
}));

jest.unstable_mockModule('../../utils/validators.js', () => ({
  validateUUID: jest.fn()
}));

describe('UserController', () => {
  let getUser;
  let userService;
  let validateUUID;
  let req, res;
  
  beforeAll(async () => {
    const module = await import('../userController.js');
    getUser = module.getUser;
    const serviceModule = await import('../../services/userService.js');
    userService = serviceModule;
    const validatorsModule = await import('../../utils/validators.js');
    validateUUID = validatorsModule.validateUUID;
  });
  
  beforeEach(() => {
    jest.clearAllMocks();
    req = {
      params: { id: 'user-id' },
      id: 'req-123'
    };
    res = {
      status: jest.fn().mockReturnThis(),
      json: jest.fn()
    };
  });
  
  describe('getUser', () => {
    it('should return user with 200 status', async () => {
      // Arrange
      const mockUser = { id: 'user-id', email: 'test@example.com' };
      userService.getUserById.mockResolvedValue(mockUser);
      
      // Act
      await getUser(req, res);
      
      // Assert
      expect(res.status).toHaveBeenCalledWith(200);
      expect(res.json).toHaveBeenCalled();
    });
  });
});
```

## Model Test Pattern

```javascript
import { jest, describe, it, expect, beforeEach } from '@jest/globals';
import { User, Company } from '../../models/index.js';
import { createUserData, createCompanyData, createAuditContext } from '../../../__tests__/helpers/factories.js';
import { cleanDatabase } from '../../../__tests__/helpers/database.js';
import { sequelize } from '../../config/database.js';

describe('ModelName', () => {
  let testUser;
  let auditContext;
  
  beforeEach(async () => {
    await cleanDatabase();
    testUser = await User.create(createUserData());
    auditContext = createAuditContext(testUser.id);
  });
  
  describe('CRUD Operations', () => {
    it('should create model with context', async () => {
      // Arrange
      const modelData = createModelData({ name: 'Test' });
      
      // Act
      const model = await ModelName.create(modelData, { context: auditContext });
      
      // Assert
      expect(model).toBeDefined();
      expect(model.createdUserId).toBe(testUser.id);
    });
  });
  
  describe('Scopes', () => {
    beforeEach(async () => {
      await sequelize.query('TRUNCATE TABLE model_names CASCADE');
    });
    
    it('should exclude deleted records by default', async () => {
      // Test scope behavior
    });
  });
});
```

