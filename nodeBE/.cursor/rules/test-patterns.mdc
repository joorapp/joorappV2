## Integration Test Pattern

```javascript
import { jest, describe, it, expect, beforeAll, afterAll } from '@jest/globals';
import request from 'supertest';
import { createTestApp, closeTestApp } from '../../../__tests__/helpers/integration.js';
import { getAuthToken } from '../../../__tests__/helpers/auth.js';
import { cleanDatabase } from '../../../__tests__/helpers/database.js';

describe('Module API Integration', () => {
  let app;
  let authToken;
  
  const TEST_USER_EMAIL = process.env.TEST_USER_EMAIL || 'test.user@example.com';
  const TEST_USER_PASSWORD = process.env.TEST_USER_PASSWORD || 'testPassword123';
  
  beforeAll(async () => {
    await cleanDatabase();
    app = await createTestApp();
    authToken = await getAuthToken(app, TEST_USER_EMAIL, TEST_USER_PASSWORD);
    
    // Sync user to database
    await request(app)
      .get('/api/v2/auth/companies')
      .set('Authorization', `Bearer ${authToken}`)
      .expect(200);
  });
  
  afterAll(async () => {
    await cleanDatabase();
    await closeTestApp(app);
  });
  
  describe('GET /api/v2/module/endpoint', () => {
    it('should return data when authenticated', async () => {
      const response = await request(app)
        .get('/api/v2/module/endpoint')
        .set('Authorization', `Bearer ${authToken}`)
        .expect(200);
      
      expect(response.body.success).toBe(true);
      expect(response.body.data).toBeDefined();
    });
  });
});
```

## Utility Test Pattern

```javascript
import { jest, describe, it, expect } from '@jest/globals';
import { validateEmail, validateUUID } from '../validators.js';
import { ValidationError } from '../errors.js';

describe('Validators', () => {
  describe('validateEmail', () => {
    it('should return true for valid email', () => {
      expect(() => validateEmail('test@example.com', 'email', 'req-123'))
        .not.toThrow();
    });
    
    it('should throw ValidationError for invalid email', () => {
      expect(() => validateEmail('invalid-email', 'email', 'req-123'))
        .toThrow(ValidationError);
    });
  });
});
```

## Middleware Test Pattern

```javascript
import { jest, describe, it, expect, beforeEach } from '@jest/globals';

describe('MiddlewareName', () => {
  let middleware;
  let req, res, next;
  
  beforeEach(() => {
    req = {
      headers: {},
      id: 'req-123'
    };
    res = {
      status: jest.fn().mockReturnThis(),
      json: jest.fn()
    };
    next = jest.fn();
  });
  
  it('should call next() when valid', async () => {
    // Arrange
    req.headers.authorization = 'Bearer valid-token';
    
    // Act
    await middleware(req, res, next);
    
    // Assert
    expect(next).toHaveBeenCalled();
    expect(next).not.toHaveBeenCalledWith(expect.any(Error));
  });
  
  it('should call next(error) when invalid', async () => {
    // Arrange
    req.headers.authorization = 'invalid';
    
    // Act
    await middleware(req, res, next);
    
    // Assert
    expect(next).toHaveBeenCalledWith(expect.any(Error));
  });
});
```

