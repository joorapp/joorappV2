# Server Configuration (REQUIRED)
PORT=3030
HOST=localhost
NODE_ENV=development

# CORS Configuration (REQUIRED)
CORS_ORIGIN=*

# Logging Configuration (REQUIRED)
# Log levels are hardcoded per transport:
# - app.log: 'info' (logs error, warn, info)
# - console: 'debug' in dev, 'info' in prod
# - error.log: 'error' (only errors)
# - access.log: 'http' (only http level)
# - sql.log: 'debug' (all levels, filtered to SQL messages only)
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5d
LOG_DATE_PATTERN=DD-MM-YYYY

# Database Configuration (PostgreSQL)
DB_NAME=joorapp_devDB
TEST_DB_NAME=joorapp_testDB
DB_USER=v2_devDB
DB_PASSWORD=v2_password_dev
DB_HOST=localhost
DB_PORT=5432

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=JOOR_APP_V2
KEYCLOAK_CLIENT_ID=Joor_App_Client
KEYCLOAK_CLIENT_SECRET=6PJsplmb7jbrr3pFrzva57RszN0oHZSp
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_DB_NAME=joorapp_KeycloakDB

# JWT Configuration (for future use)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# API Configuration
API_VERSION=v2
API_PREFIX=/api


# SWAGGER Configurations
SWAGGER_ENABLED=true
