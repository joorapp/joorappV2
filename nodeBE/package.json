{
  "name": "joorapp-backend",
  "version": "2.0.0",
  "description": "Node.js backend API for JoorApp V2",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-tests.js --runInBand --coverage",
    "test:quick": "node scripts/run-tests.js --runInBand",
    "test:watch": "node scripts/run-tests.js --runInBand --watch",
    "test:unit": "node scripts/run-tests.js --runInBand --testPathPattern=unit",
    "test:integration": "node scripts/run-tests.js --runInBand --testPathPattern=integration",
    "test-db": "node scripts/test-db-connection.js",
    "migrate": "node scripts/migrate-database.js dev up",
    "migrate:dev": "node scripts/migrate-database.js dev up",
    "migrate:dev:down": "node scripts/migrate-database.js dev down",
    "migrate:test": "node scripts/migrate-database.js test up",
    "migrate:test:down": "node scripts/migrate-database.js test down",
    "migrate:up": "node scripts/run-migration.js",
    "migrate:down": "node scripts/run-migration.js",
    "verify:users": "node scripts/verify-users-table.js",
    "migrate:demo:up": "node scripts/run-migration.js create-demo-auditable-models up",
    "migrate:demo:down": "node scripts/run-migration.js create-demo-auditable-models down",
    "test:user-model": "node scripts/test-user-model.js",
    "test:demo-model": "node scripts/test-demo-auditable-model.js",
    "test:model-init": "node scripts/test-model-initialization.js",
    "test:keycloak": "node scripts/test-keycloak-service.js",
    "test:error-handling": "node scripts/test-error-handling.js",
    "test:users": "node scripts/test-users-module.js",
    "configure:super-admin": "node scripts/configure-first-super-admin.js",
    "setup:test-users": "node scripts/setup-test-users.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "express",
    "api",
    "nodejs",
    "backend",
    "es6",
    "keycloak"
  ],
  "author": "Bhavesh Venugopal",
  "license": "ISC",
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.2.5",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.0",
    "sequelize": "^6.37.7",
    "sql-formatter": "^15.6.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "umzug": "^3.8.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}
