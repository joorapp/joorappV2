# ============================================
# Frontend Environment Variables
# ============================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ============================================
# API Configuration (REQUIRED)
# ============================================
# Backend API base URL (without trailing slash)
# Default: http://localhost:3030
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3030

# API request timeout in milliseconds
# Default: 10000 (10 seconds)
VITE_API_TIMEOUT=10000

# API version path (optional, if different from default)
# Default: /api/v2
# VITE_API_PATH=/api/v2

# ============================================
# Application Configuration (OPTIONAL)
# ============================================
# Application name
# VITE_APP_NAME=JoorApp

# Application version
# VITE_APP_VERSION=2.0.0

# Application title (for browser tab)
# VITE_APP_TITLE=JoorApp - Business Management Platform

# ============================================
# UI/UX Configuration (OPTIONAL)
# ============================================
# Toast notification auto-close duration in milliseconds
# Default: 5000 (5 seconds)
VITE_TOAST_AUTO_CLOSE=5000

# Toast notification position
# Options: top-right, top-left, top-center, bottom-right, bottom-left, bottom-center
# Default: top-right
# VITE_TOAST_POSITION=top-right

# Default language (fallback if browser language not detected)
# Options: en, de, ar
# Default: en
# VITE_DEFAULT_LANGUAGE=en

# ============================================
# Feature Flags (OPTIONAL - for future use)
# ============================================
# Enable/disable specific features
# VITE_FEATURE_ANALYTICS_ENABLED=true
# VITE_FEATURE_CHAT_ENABLED=false
# VITE_FEATURE_REPORTS_ENABLED=true
# VITE_FEATURE_EXPORT_ENABLED=true

# ============================================
# External Services (OPTIONAL - for future use)
# ============================================
# Error tracking (Sentry)
# VITE_SENTRY_DSN=your-sentry-dsn-here
# VITE_SENTRY_ENVIRONMENT=production

# Analytics (Google Analytics)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Analytics (Google Tag Manager)
# VITE_GTM_ID=GTM-XXXXXXX

# ============================================
# Development Configuration (OPTIONAL)
# ============================================
# Enable debug mode for i18n
# Automatically set by NODE_ENV in Vite (development/production)
# VITE_DEBUG_MODE=false

# Enable API request logging
# VITE_API_LOGGING_ENABLED=false

# ============================================
# Pagination & List Configuration (OPTIONAL)
# ============================================
# Default page size for paginated lists
# VITE_DEFAULT_PAGE_SIZE=10

# Maximum page size for paginated lists
# VITE_MAX_PAGE_SIZE=100

